# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/amane_bio?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/amane_bio_test?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

APP_TIMEZONE="Africa/Casablanca"
APP_DEFAULT_CURRENCY="MAD"
